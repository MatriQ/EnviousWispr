{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "macOS permission prompt (NSAppleEventsUsageDescription), shown when the app first asks for this access. Say exactly what the app does with it, no more and no less.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr uses AppleScript to paste your dictated text into the active app when direct insertion is not available, and to pause Music or Spotify while you dictate if you choose that setting."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr verwendet AppleScript, um deinen diktierten Text in die aktive App einzufügen, wenn das direkte Einfügen nicht möglich ist, und um Musik oder Spotify während des Diktierens anzuhalten, wenn du diese Einstellung wählst."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法直接插入时，EnviousWispr 会使用 AppleScript 将语音输入的文字粘贴到当前应用；如果启用了相应设置，还会在录音时暂停 Music 或 Spotify。"
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "macOS permission prompt (NSContactsUsageDescription), shown when the app first asks for this access. Say exactly what the app does with it, no more and no less.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr reads the names in your contacts so dictation can spell the people you know correctly. Your address book is never uploaded."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr liest die Namen deiner Kontakte, damit die Namen von Menschen, die du kennst, beim Diktieren richtig geschrieben werden. Dein Adressbuch wird nie hochgeladen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr 读取通讯录中的姓名，帮助正确识别和书写人名。你的通讯录不会上传。"
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
      "comment" : "About box: the copyright line. Legal text: keep the company name and the years exactly.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copyright © 2025–2026 Envious Labs LLC. All rights reserved."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copyright © 2025–2026 Envious Labs LLC. Alle Rechte vorbehalten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "版权所有 © 2025–2026 Envious Labs LLC。保留所有权利。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "macOS permission prompt (NSMicrophoneUsageDescription), shown when the app first asks for this access. Say exactly what the app does with it, no more and no less.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr needs microphone access for speech-to-text dictation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr benötigt Zugriff auf dein Mikrofon, um deine Sprache in Text umzuwandeln."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr 需要访问麦克风，将你的语音转换成文字。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "macOS permission prompt (NSSpeechRecognitionUsageDescription), shown when the app first asks for this access. Say exactly what the app does with it, no more and no less.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr uses on-device speech recognition to show your words in the recording pill while you speak. This preview stays on your Mac and is never the text that gets pasted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr verwendet die Spracherkennung auf dem Gerät, um deine Worte beim Sprechen in der Aufnahmeanzeige anzuzeigen. Diese Vorschau bleibt auf deinem Mac und ist nie der Text, der eingefügt wird."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr 使用本机语音识别，在录音浮动条中实时预览文字。预览内容始终留在你的 Mac 上，最终粘贴的文字由主识别引擎生成。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
