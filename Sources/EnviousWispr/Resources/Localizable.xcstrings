    },
    "The add-a-word keybind (%@) isn't working. macOS says this key combination is already taken. Choose another." : {
      "comment" : "Keybinds settings: an external conflict warning. %@ is a key combination, such as Right ⌘.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
