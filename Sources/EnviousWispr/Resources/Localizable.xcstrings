    "%@ by Superwhisper" : {
      "comment" : "AI Polish, Ollama: credit above the writing-style dials when the Ollama model is S1-mini. %@ is S1-mini. Keep Superwhisper as written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ von Superwhisper"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@由Superwhisper"
          }
        }
      }
    },
    "%@ by Superwhisper is a small cleanup model that runs on this Mac and works offline, with no API key to manage." : {
      "comment" : "AI Polish, Why use S1-mini: first paragraph. %@ is the model name, S1-mini. Keep Superwhisper as written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ von Superwhisper ist ein kleines Bereinigungsmodell, das auf diesem Mac läuft und offline funktioniert, ohne API-Schlüssel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superwhisper的%@是一个小型清理模型，在这台Mac上运行并离线工作，没有API密钥需要管理。"
          }
        }
      }
    },
    "%@ channels" : {
