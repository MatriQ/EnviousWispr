    "whatsNew.update-when-ready.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry update-when-ready).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New versions show up as a quiet in-app banner instead of an interrupting popup. You stay in flow, then update on your schedule."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Versionen erscheinen als unaufdringlicher Hinweis in der App statt als unterbrechendes Pop-up. Du kannst deine Arbeit fortsetzen und das Update später installieren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新版本显示为安静的应用程序内横幅，而不是中断的弹出窗口。 你保持流程，然后更新你的日程安排。"
          }
        }
      }
    },
    "whatsNew.stronger-privacy-by-default.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry stronger-privacy-by-default).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stronger privacy, by default"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Datenschutz als Standard"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认情况下，更强的隐私"
          }
        }
      }
    },
    "whatsNew.stronger-privacy-by-default.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry stronger-privacy-by-default).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud polish now opts out of training storage where supported. Crash reports scrub sensitive details before they leave your Mac. Stored files have tighter permissions. Gemini request logging is off. The Privacy section explains what each cloud provider keeps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Cloud-Nachbearbeitung schließt die Speicherung zu Trainingszwecken aus, wo der Anbieter dies unterstützt. Absturzberichte werden vor dem Verlassen deines Mac von sensiblen Angaben bereinigt. Gespeicherte Dateien haben strengere Zugriffsrechte. Die Protokollierung von Gemini-Anfragen ist ausgeschaltet. Unter „Datenschutz“ erfährst du, was die einzelnen Cloud-Anbieter aufbewahren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "云润色现在选择退出受支持的训练存储。 崩溃报告在敏感细节离开您的 Mac 之前被清除。 存储的文件具有更严格的权限。 Gemini请求日志已关闭。 隐私部分解释了每个云提供商保留的内容。"
          }
        }
      }
    },
    "whatsNew.smoother-model-switching.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry smoother-model-switching).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smoother model switching"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reibungsloserer Modellwechsel"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更顺畅的模型切换"
          }
        }
      }
    },
    "whatsNew.smoother-model-switching.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry smoother-model-switching).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switching between local AI polish models now frees up the previous model cleanly, so your Mac stays responsive and recordings keep working."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wechsel zwischen lokalen Modellen zur KI-Nachbearbeitung wird das bisherige Modell jetzt sauber freigegeben. Dein Mac bleibt reaktionsschnell und Aufnahmen funktionieren weiter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在本地AI 润色模型之间切换现在可以干净地释放上一个模型，因此您的Mac保持响应，录音继续工作。"
          }
        }
      }
    },
    "whatsNew.more-reliable-recordings.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry more-reliable-recordings).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More reliable recordings"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuverlässigere Aufnahmen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更可靠的录音"
          }
        }
      }
    },
    "whatsNew.more-reliable-recordings.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry more-reliable-recordings).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fewer silent failures. The audio helper now recovers cleanly from a rare crash class, and the microphone bounces back better from bad states after long idle periods or audio interruptions."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger unbemerkte Fehler: Der Audio-Hilfsprozess erholt sich jetzt sauber von einer seltenen Absturzart. Auch das Mikrofon findet nach langer Inaktivität oder einer Audiounterbrechung zuverlässiger in einen funktionierenden Zustand zurück."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更少的无声失败。 音频助手现在从罕见的崩溃类中恢复得干净利落，在长时间闲置或音频中断后，麦克风从不良状态中恢复得更好。"
          }
        }
      }
    },
