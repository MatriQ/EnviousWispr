    "whatsNew.send-feedback.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry send-feedback).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send Feedback"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback senden"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送反馈"
          }
        }
      }
    },
    "whatsNew.send-feedback.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry send-feedback).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introducing \"Send Feedback\". Click the bug button beside Record to tell us what works and what doesn't, with an optional email if you'd like a reply. Your draft is saved on your Mac as you type."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu: „Feedback senden“. Klicke auf den Käfer-Knopf neben „Aufnehmen“ und sag uns, was funktioniert und was nicht, auf Wunsch mit deiner E-Mail-Adresse für eine Antwort. Dein Entwurf wird beim Tippen auf deinem Mac gespeichert."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "介绍“发送反馈”。 单击“记录”旁边的错误按钮，告诉我们哪些有效，哪些不有效，如果您想要回复，请提供可选的电子邮件。 在您键入时，您的草稿会保存在 Mac 上。"
          }
        }
      }
    },
    "whatsNew.apple-intelligence-polish-faster-and-cleaner.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry apple-intelligence-polish-faster-and-cleaner).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence polish is faster and cleaner"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnellere und sauberere Nachbearbeitung mit Apple Intelligence"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence润色速度更快、更干净"
          }
        }
      }
    },
    "whatsNew.apple-intelligence-polish-faster-and-cleaner.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry apple-intelligence-polish-faster-and-cleaner).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On macOS 26 and 27, Apple Intelligence polish now finishes sooner, up to about a third faster on macOS 27, lays out spoken lists as lists and resolves more of your spoken corrections, like \"on Tuesday, sorry, Wednesday\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter macOS 26 und 27 ist die Nachbearbeitung mit Apple Intelligence jetzt schneller, unter macOS 27 um bis zu etwa ein Drittel, formatiert gesprochene Aufzählungen als Listen und setzt mehr deiner gesprochenen Korrekturen um, etwa „am Dienstag, nein, am Mittwoch“."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在macOS 26和27上，Apple Intelligence润色现在完成得更快，在macOS 27上快了大约三分之一，将语音列表作为列表，并解决更多语音更正，例如“周二，对不起，周三”。"
          }
        }
      }
    },
    "whatsNew.media-during-dictation.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry media-during-dictation).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower, mute, pause audio while dictating"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio beim Diktieren leiser stellen, stummschalten oder pausieren"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在语音输入时降低、静音、暂停音频"
          }
        }
      }
    },
    "whatsNew.media-during-dictation.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry media-during-dictation).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what your music and videos do while you dictate: Continue, Lower, Mute or Pause. Pause picks the same song or video back up when you finish. It lives on the redesigned Microphone page in Settings."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, was deine Musik und Videos beim Diktieren tun: Fortfahren, Leiser, Stummschalten oder Pausieren. Mit „Pausieren“ läuft derselbe Song oder dasselbe Video weiter, sobald du fertig bist. Du findest die Einstellung auf der neu gestalteten Seite „Mikrofon“ in den Einstellungen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您口述时，选择您的音乐和影片的工作：继续、降低、静音或暂停。 在您完成后，暂停会选择相同的歌曲或视频。 它位于“设置”中重新设计的“麦克风”页面上。"
          }
        }
      }
    },
    "whatsNew.import-your-snippets.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry import-your-snippets).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import your snippets"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere deine Textbausteine"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入您的片段"
          }
        }
      }
    },
    "whatsNew.import-your-snippets.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry import-your-snippets).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring snippets in from the file you exported, a CSV, a list you paste, or straight from Wispr Flow or TypeWhisper. You review the list before anything is saved, snippets you already have are skipped, and your keyword stays as it is."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere Textbausteine aus einer exportierten Datei, einer CSV-Datei, einer eingefügten Liste oder direkt aus Wispr Flow oder TypeWhisper. Du prüfst die Liste, bevor etwas gespeichert wird. Vorhandene Textbausteine werden übersprungen und dein Schlüsselwort bleibt erhalten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从您导出的文件、CSV、您粘贴的列表或直接从Wispr Flow或TypeWhisper中引入片段。 在保存任何东西之前，您查看列表，跳过您已有的片段，您的关键字保持原有状态。"
          }
        }
      }
    },
    "whatsNew.snippet-dynamic-values.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry snippet-dynamic-values).",
      "extractionState" : "manual",
      "localizations" : {
