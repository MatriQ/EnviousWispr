      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completely redesigned the settings UI to eliminate clutter, featuring a new search bar to quickly jump to any configuration option."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen wurden komplett neu gestaltet und aufgeräumt. Über die neue Suchleiste springst du schnell zu jeder Option."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全重新设计了设置用户界面，以消除杂乱，并具有一个新的搜索栏，可以快速跳转到任何配置选项。"
          }
        }
      }
    },
