      }
    },
    "The app you were in has closed, so there was nothing left to read. You can still add the word by hand below." : {
      "comment" : "Quick Add panel: why the selected text could not be read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App, in der du warst, wurde geschlossen. Deshalb konnte der markierte Text nicht gelesen werden. Du kannst das Wort unten trotzdem von Hand hinzufügen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您所使用的应用程序已关闭，所以没有任何东西可以阅读。 您仍然可以在下面手工添加单词。"
          }
        }
      }
    },
    "The cancel keybind (%@) isn't working while you're recording. macOS says this key combination is already taken. Choose another." : {
