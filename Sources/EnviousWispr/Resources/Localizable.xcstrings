    "whatsNew.versions-ips-codes-whole.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry versions-ips-codes-whole).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smarter technical and developer formatting: Technical patterns, network addresses, and standard data types now convert directly into clean, written notation instead of spelled-out words."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bessere Formatierung für Technik und Entwicklung: Technische Muster, Netzwerkadressen und gängige Datenformate erscheinen jetzt direkt in sauberer Schreibweise statt als ausgeschriebene Wörter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更智慧的技术和开发人员格式：技术模式、网路地址和标准资料型别现在直接转换为干净的书面符号，而不是拼出的单词。"
          }
        }
      }
    },
