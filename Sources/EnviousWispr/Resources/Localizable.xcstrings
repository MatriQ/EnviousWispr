    "whatsNew.paste-to-starting-chrome-window.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry paste-to-starting-chrome-window).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you start dictating in one Chrome window and switch to another Chrome window before you stop, EnviousWispr now goes back to the first window and pastes there. If you closed the first window, your words stay on the clipboard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du in einem Chrome-Fenster mit dem Diktieren beginnst und vor dem Beenden zu einem anderen Chrome-Fenster wechselst, kehrt EnviousWispr jetzt zum ersten Fenster zurück und fügt dort ein. Wenn du das erste Fenster geschlossen hast, bleiben deine Wörter in der Zwischenablage."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您在一个Chrome窗口中开始语音输入，并在停止之前切换到另一个Chrome窗口，EnviousWispr现在会返回第一个窗口并粘贴在那里。 如果您关闭了第一个窗口，您的文字将保留在剪贴板上。"
          }
        }
      }
    },
    "whatsNew.longer-undo-for-learned-words.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry longer-undo-for-learned-words).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More time to Undo a learned word"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Zeit für „Rückgängig“ bei gelernten Wörtern"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有更多的时间来撤销习得的单词"
          }
        }
      }
    },
    "whatsNew.longer-undo-for-learned-words.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry longer-undo-for-learned-words).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When Self-Learning saves a word, the Undo button now stays for 4 seconds instead of 3. A bar shows how much time is left."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das Selbstlernende Wörterbuch ein Wort speichert, bleibt die Schaltfläche „Rückgängig“ jetzt 4 statt 3 Sekunden sichtbar. Ein Balken zeigt, wie viel Zeit noch bleibt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自学保存单词时，撤销按钮现在停留 4 秒，而不是 3 秒。 条形图显示还剩多少时间。"
          }
        }
      }
    },
    "whatsNew.self-learning-skips-punctuation.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry self-learning-skips-punctuation).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smarter Self-Learning"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intelligenteres Selbstlernen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更智能的自学"
          }
        }
      }
    },
    "whatsNew.self-learning-skips-punctuation.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry self-learning-skips-punctuation).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Self-Learning Dictionary no longer learns edits that only add punctuation, such as \"e mail\" to \"e-mail\" or \"U S\" to \"U.S.\". It also needs to be more certain before it learns from an edit that you may not have finished."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Selbstlernende Wörterbuch lernt keine Änderungen mehr, die nur Satzzeichen hinzufügen, etwa „e mail“ zu „e-mail“ oder „U S“ zu „U.S.“. Außerdem braucht es mehr Sicherheit, bevor es aus einer Änderung lernt, die du vielleicht noch nicht abgeschlossen hast."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自学词典不再学习只添加标点符号的编辑，例如“电子邮件”到“电子邮件”或“美国”到“美国”。 在从您可能没有完成的编辑中学习之前，它还需要更加确定。"
          }
        }
      }
    },
    "whatsNew.self-learning-dictionary.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry self-learning-dictionary).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Self-Learning Dictionary"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbstlernendes Wörterbuch"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自学词典"
          }
        }
      }
    },
    "whatsNew.self-learning-dictionary.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry self-learning-dictionary).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcription models like Parakeet and WhisperKit can occasionally mishear phonetically similar words or jargon. When you correct an output, the system now automatically detects the change and adds the intended term to your dictionary."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spracherkennungsmodelle wie Parakeet und WhisperKit verhören sich gelegentlich bei ähnlich klingenden Wörtern oder Fachbegriffen. Wenn du ein Ergebnis korrigierst, erkennt EnviousWispr die Änderung jetzt automatisch und übernimmt den gemeinten Begriff in dein Wörterbuch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet和WhisperKit等转录模型偶尔会误解语音相似的单词或行话。 当您更正输出时，系统现在会自动检测更改，并将预期术语添加到您的字典中。"
          }
        }
      }
    },
    "whatsNew.self-learning-dictionary.bullet.0" : {
      "comment" : "Settings > What's New: point 1 of the list under one feature announcement (entry self-learning-dictionary).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Context-aware replacement: The tool now recognizes when a standard dictionary word should be replaced with a specific term or proper noun (e.g., \"Twist\" to \"Tuist\") for more accurate future transcriptions."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzen mit Blick auf den Zusammenhang: EnviousWispr erkennt jetzt, wann ein gewöhnliches Wort durch einen bestimmten Begriff oder Eigennamen ersetzt werden sollte (etwa „Twist“ durch „Tuist“), für genauere künftige Diktate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下文感知替换：该工具现在可以识别何时将标准字典单词替换为特定术语或专有名词（例如，“Twist”到“Tuist”），以便更准确的未来转录。"
          }
        }
      }
    },
    "whatsNew.self-learning-dictionary.bullet.1" : {
      "comment" : "Settings > What's New: point 2 of the list under one feature announcement (entry self-learning-dictionary).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Self-Learning Dictionary help article has more."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr dazu im Hilfeartikel zum selbstlernenden Wörterbuch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自学词典帮助文章包含更多内容。"
          }
        }
      }
    },
    "whatsNew.enviouswispr-in-german.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry enviouswispr-in-german).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now available natively in German"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt auch auf Deutsch"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在提供德语原生版本"
          }
        }
      }
    },
    "whatsNew.enviouswispr-in-german.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry enviouswispr-in-german).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Deutsch in Settings > Appearance > Language, then relaunch to apply. System default follows your Mac's language."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle „Deutsch“ unter Einstellungen > Erscheinungsbild > Sprache und starte die App dann neu. „Systemstandard“ folgt der Sprache deines Macs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”>“外观”>“语言”中选择德语，然后重新启动以申请。 系统默认设置遵循 Mac 的语言。"
          }
        }
      }
    },
    "whatsNew.paste-last-dictation.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry paste-last-dictation).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste Last Dictation"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letztes Diktat einfügen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴最后的语音输入"
          }
        }
      }
    },
    "whatsNew.paste-last-dictation.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry paste-last-dictation).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ever finish dictating only to realize your cursor wasn't focused in a text box? Or wanted to drop your exact last thought into a second app? Meet Paste Last Dictation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertig diktiert, aber der Cursor stand in keinem Textfeld? Oder du möchtest denselben Gedanken in eine zweite App bringen? Hier kommt „Letztes Diktat einfügen“."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有没有在语音输入完后才发现你的光标没有聚焦在文本框中？ 还是想把你最后的想法放在第二个应用程序中？ 遇见粘贴最后的语音输入。"
          }
        }
      }
    },
    "whatsNew.paste-last-dictation.bullet.0" : {
      "comment" : "Settings > What's New: point 1 of the list under one feature announcement (entry paste-last-dictation).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste instantly: ⌃⌘V drops your most recent transcription wherever your cursor is right now."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sofort einfügen: ⌃⌘V fügt dein letztes Diktat dort ein, wo dein Cursor gerade steht."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即时粘贴：⌃⌘V将您最近的转录丢弃，无论您现在的光标在哪里。"
          }
        }
      }
    },
    "whatsNew.paste-last-dictation.bullet.1" : {
      "comment" : "Settings > What's New: point 2 of the list under one feature announcement (entry paste-last-dictation).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy to clipboard: ⌃⌘C puts it straight onto your clipboard so you can reuse it later."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In die Zwischenablage kopieren: ⌃⌘C legt es direkt in deine Zwischenablage, damit du es später weiterverwenden kannst."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制到剪贴板：⌃⌘C将其直接放在剪贴板上，以便您以后可以重复使用。"
          }
        }
      }
    },
    "whatsNew.paste-last-dictation.bullet.2" : {
      "comment" : "Settings > What's New: point 3 of the list under one feature announcement (entry paste-last-dictation).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste Last Dictation is in your menu bar too, and you can customize either shortcut under Settings > Keybinds. Never lose a spoken thought to a missed click again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Letztes Diktat einfügen“ findest du auch in der Menüleiste, und beide Kurzbefehle kannst du unter Einstellungen > Tastenkürzel ändern. Kein gesprochener Gedanke geht mehr durch einen verpassten Klick verloren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴“最后语音输入”也位于菜单栏中，您可以在“设置”>“快捷键”下自定义任何快捷键。 再也不会因为错过的点击而失去说话的想法。"
          }
        }
      }
    },
    "whatsNew.paste-lands-where-you-started.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry paste-lands-where-you-started).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Improvements to \"remembering initial text box\""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbesserungen beim Merken des ursprünglichen Textfelds"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对“记住初始文本框”的改进"
          }
        }
      }
    },
    "whatsNew.paste-lands-where-you-started.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry paste-lands-where-you-started).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr is now better at pasting where it's supposed to paste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr fügt jetzt zuverlässiger dort ein, wo es einfügen soll."
          }
        },
        "zh-Hans" : {
