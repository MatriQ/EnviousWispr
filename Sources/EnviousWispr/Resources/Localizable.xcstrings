            "state" : "translated",
            "value" : "带有光和水平仪的紧凑型药丸。"
          }
        }
      }
    },
    "A dictation is running. Try again when it finishes." : {
      "comment" : "Transcribe a File: why the file was refused.",
      "localizations" : {
        "de" : {
