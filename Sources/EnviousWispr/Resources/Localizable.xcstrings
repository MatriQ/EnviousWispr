    "whatsNew.keybind-conflict-warning.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry keybind-conflict-warning).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If macOS says a key combination is already taken, Settings > Keybinds now shows a warning under that shortcut. Choose a different key combination to fix it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn macOS meldet, dass eine Tastenkombination bereits vergeben ist, zeigt Einstellungen > Tastenkürzel jetzt eine Warnung unter diesem Kürzel. Wähle eine andere Tastenkombination, um das zu beheben."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 macOS 显示已使用组合键，“设置”>“键合”现在会在该快捷键下显示警告。 选择不同的组合键来修复它。"
          }
        }
      }
    },
