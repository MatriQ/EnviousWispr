        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说“%@”来插入句期。"
          }
        }
      }
    },
    "Say \"<phrase> emoji\" to get the glyph. Bare words never convert." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag „<Ausdruck> Emoji“, um das Symbol einzufügen. Ohne „Emoji“ werden Wörter nicht umgewandelt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说“<短语>表情符号”来获取字形。 光著话永远不会转换。"
          }
        }
      }
    },
    "Say a phrase followed by emoji to get its symbol." : {
      "comment" : "Speech engine settings: short line under the spoken emoji row.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag einen Ausdruck und danach „Emoji“, um das Symbol einzufügen."
