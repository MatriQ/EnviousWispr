    "Auto-detect your language, or lock to a specific one. WhisperKit supports 99+ languages." : {
      "comment" : "Speech engine settings, Language section: explanation for the multilingual engine (WhisperKit).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass deine Sprache automatisch erkennen oder wähle eine feste Sprache. WhisperKit unterstützt über 99 Sprachen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动检测您的语言，或锁定为特定语言。 WhisperKit支持99多种语言。"
          }
        }
      }
    },
    "Auto-detect your language, or lock to one of 25 European languages. Locking helps stop the fast engine reaching for a different alphabet, like Greek or Cyrillic appearing in German. It cannot tell apart two languages written in the same alphabet." : {
      "comment" : "Speech engine settings, Language section: explanation for the fast engine.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass deine Sprache automatisch erkennen oder lege eine von 25 europäischen Sprachen fest. Das hilft, bei der schnellen Engine andere Schriften zu vermeiden, etwa griechische oder kyrillische Zeichen in einem deutschen Diktat. Sprachen mit demselben Alphabet kann die Engine nicht unterscheiden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动检测您的语言，或锁定25种欧洲语言之一。 锁定有助于阻止快速引擎到达不同的字母，如希腊语或西里尔字母出现在德语中。 它无法区分用同一字母书写的两种语言。"
          }
        }
      }
    },
    "Auto-learned" : {
