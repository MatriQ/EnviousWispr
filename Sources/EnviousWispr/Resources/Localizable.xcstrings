    "whatsNew.addresses-links-codes-in-four-languages.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry addresses-links-codes-in-four-languages).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localized spoken formatting: With your dictation language set to French, Spanish, Polish, Dutch, German, Russian, Portuguese or Italian, spoken URLs, emails and technical codes now come out written."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesprochene Formatierung in deiner Sprache: Wenn deine Diktiersprache auf Französisch, Spanisch, Polnisch, Niederländisch, Deutsch, Russisch, Portugiesisch oder Italienisch eingestellt ist, werden gesprochene Webadressen, E-Mail-Adressen und technische Codes jetzt richtig geschrieben."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地化语音格式：将语音输入语言设置为法语、西班牙语、润色、荷兰语、德语、俄语、葡萄牙语或意大利语，语音URL、电子邮件和技术代码现在以书面形式出现。"
          }
        }
      }
    },
