      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose English (UK) as your dictation language and your text comes out in British spelling, like colour, organisation and centre. It works for dictation and Transcribe a File, with polishing on or off."
