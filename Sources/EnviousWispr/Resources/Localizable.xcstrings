        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung unter „Tastenkürzel“"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快捷键中的快捷指令警告"
          }
        }
      }
