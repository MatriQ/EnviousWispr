    },
    "whatsNew.dock-icon-and-window-in-front.bullet.0" : {
      "comment" : "Settings > What's New: point 1 of the list under one feature announcement (entry dock-icon-and-window-in-front).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Better menu bar placement: Unless you've moved it, the menu bar icon now sits further to the right near your system icons, making it quicker to spot."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bessere Position in der Menüleiste: Wenn du das Menüleistensymbol nie verschoben hast, sitzt es jetzt weiter rechts bei den Systemsymbolen und ist schneller zu finden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更好的菜单栏位置：除非您移动了它，否则菜单栏图标现在位于系统图标附近的右侧，以便更快地发现它。"
          }
