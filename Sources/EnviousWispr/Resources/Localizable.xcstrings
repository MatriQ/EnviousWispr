    "whatsNew.undo-after-escape.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry undo-after-escape).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undo after Escape now pastes your words into the field you were in, or copies them to your clipboard if it can't paste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Rückgängig“ nach Escape fügt deine Wörter jetzt in das Feld ein, in dem du warst, oder kopiert sie in die Zwischenablage, wenn das Einfügen nicht möglich ist."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出后撤销现在会将您的单词粘贴到您所在的字段中，或者如果无法粘贴，请将它们复制到剪贴板。"
          }
        }
      }
    },
    "whatsNew.privacy-controls.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry privacy-controls).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy controls"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenschutzeinstellungen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐私控制"
          }
        }
      }
    },
    "whatsNew.privacy-controls.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry privacy-controls).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introducing \"Privacy controls\". Choose whether to share usage metrics and crash reports in Settings > Permissions. Crash report changes apply after a restart. When sending feedback, choose whether to attach diagnostics and preview the file first."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu: „Datenschutzeinstellungen“. Unter Einstellungen > Berechtigungen legst du fest, ob du Nutzungsstatistiken teilst und Absturzberichte sendest. Änderungen an der Einstellung für Absturzberichte werden nach einem Neustart wirksam. Beim Senden von Feedback entscheidest du, ob Diagnosedaten angehängt werden, und kannst die Datei vorher ansehen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "介绍“隐私控制”。 在“设置”>“权限”中选择是否共享使用情况指标和崩溃报告。 崩溃报告更改在重新启动后生效。 发送反馈时，选择是否先附加诊断程序并预览文件。"
          }
        }
      }
    },
    "whatsNew.word-check-memory.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry word-check-memory).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word check loads on demand"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wortprüfung wird bei Bedarf geladen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按需加载单词检查"
          }
        }
      }
    },
    "whatsNew.word-check-memory.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry word-check-memory).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envious Word Check now loads on demand instead of loading when EnviousWispr starts. It normally leaves memory after about 10 minutes without use; a dictation or file transcription still using it can keep it longer. EG-1 and S1-mini dictations use their own word checks."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envious Word Check wird jetzt bei Bedarf geladen und nicht mehr beim Start von EnviousWispr. Normalerweise wird er nach etwa 10 Minuten ohne Nutzung wieder aus dem Arbeitsspeicher entfernt. Wenn ein Diktat oder eine Dateitranskription ihn noch nutzt, bleibt er länger im Arbeitsspeicher. Diktate mit EG-1 und S1-mini verwenden ihre eigene Wortprüfung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envious Word Check现在按需加载，而不是在EnviousWispr启动时加载。 它通常在不使用约10分钟后留下记忆；仍然使用它的语音输入或文件转录可以保留更长时间。 EG-1和S1-mini语音输入使用它们自己的单词检查。"
          }
        }
      }
    },
    "whatsNew.help-before-feedback.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry help-before-feedback).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help before you send feedback"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilfe, bevor du Feedback sendest"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送反馈前的帮助"
          }
        }
      }
    },
    "whatsNew.help-before-feedback.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry help-before-feedback).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you press Send in Send Feedback, EnviousWispr now shows up to three help articles that might answer your question. Read an article, or send your message as you wrote it. On macOS 26 or later with Apple Intelligence on, you can mark each part of your message solved and choose not to send it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du unter „Feedback senden“ auf „Senden“ klickst, zeigt EnviousWispr jetzt bis zu drei Hilfeartikel, die deine Frage beantworten könnten. Lies einen Artikel oder sende deine Nachricht so, wie du sie geschrieben hast. Ab macOS 26 mit aktivierter Apple Intelligence kannst du jeden Teil deiner Nachricht als gelöst markieren und die Nachricht dann nicht senden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您在“发送反馈”中按下“发送”键时，EnviousWispr现在最多会显示三篇可能回答您问题的帮助文章。 阅读一篇文章，或按照您写的内容发送消息。 在 macOS 26 或更高版本上，打开了 Apple Intelligence，您可以将消息的每个部分标记为已解决，并选择不发送。"
          }
        }
      }
    },
    "whatsNew.keybind-conflict-warning.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry keybind-conflict-warning).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcut warning in Keybinds"
