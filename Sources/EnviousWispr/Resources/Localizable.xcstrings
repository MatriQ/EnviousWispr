        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的关键词必须是一个单词。 选择一个你不会不小心说出来的。"
          }
        }
      }
    },
    "Your microphone is working. We just did not hear anything.\nTry holding %@ and saying: tell grandma I will call Sunday." : {
