      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menu bar only mode: Prefer a distraction-free setup? Turn off Show app in Dock under Settings > Appearance to keep EnviousWispr tucked away exclusively in your menu bar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur in der Menüleiste: Du möchtest es aufgeräumt? Deaktiviere „App im Dock anzeigen“ unter Einstellungen > Erscheinungsbild, dann bleibt EnviousWispr nur in deiner Menüleiste."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
