    "whatsNew.apple-intelligence-multilingual.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry apple-intelligence-multilingual).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI polish with Apple Intelligence now preserves the language you spoke in. German stays German, Korean stays Korean. Languages Apple Intelligence cannot handle are quietly skipped so you always get your raw transcript instead of a silent failure."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI-Nachbearbeitung mit Apple Intelligence bewahrt jetzt deine gesprochene Sprache. Deutsch bleibt Deutsch, Koreanisch bleibt Koreanisch. Kann Apple Intelligence eine Sprache nicht bearbeiten, erhältst du stattdessen unauffällig das rohe Transkript."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人工智能与苹果智能的润色现在保留了您所使用的语言。 德国人留德语，韩国人留韩国人。 Apple Intelligence无法处理的语言被悄悄跳过，因此您总是得到原始转写文本，而不是无声的失败。"
          }
        }
      }
    },
