        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Englisch (UK) als Diktiersprache, und dein Text erscheint in britischer Schreibweise, etwa colour, organisation und centre. Das gilt für Diktate und „Datei transkribieren“, mit und ohne Nachbearbeitung."
          }
        },
        "zh-Hans" : {
