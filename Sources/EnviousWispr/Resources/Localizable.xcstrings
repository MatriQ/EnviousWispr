    "whatsNew.snippet-dynamic-values.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry snippet-dynamic-values).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insert the current date, current time, or your last copied text into snippets. Dynamic values resolve instantly on trigger, and clipboard contents are read strictly when the snippet fires."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge das aktuelle Datum, die aktuelle Uhrzeit oder deinen zuletzt kopierten Text in Textbausteine ein. Die Werte werden erst beim Auslösen eingesetzt, und die Zwischenablage wird nur gelesen, wenn der Textbaustein tatsächlich ausgelöst wird."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将当前日期、当前时间或上次复制的文本插入片段中。 动态值在触发时立即解析，当片段触发时，剪贴板内容会严格读取。"
          }
        }
      }
    },
