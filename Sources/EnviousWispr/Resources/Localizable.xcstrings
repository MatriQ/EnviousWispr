          }
        }
      }
    },
    "Say comma or new paragraph to insert it." : {
      "comment" : "Speech engine settings: short line under the spoken punctuation row.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag „comma“ oder „new paragraph“, um es einzufügen."
          }
